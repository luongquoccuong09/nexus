{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "NexusSecurity": {
    "AllowedOrigins": [],
    "MaxRequestBodyBytes": 10485760,
    "MaxPageSize": 50,
    "RateLimitPermitsPerMinute": 120,
    "HubPathPrefix": "/hubs"
  },
  "NexusStorage": {
    "Provider": "Local",
    "LocalRootPath": "App_Data/storage",
    "SignedUrlTtlSeconds": 60
  },
  "NexusIdentity": {
    "RegistrationMode": "Open",
    "CurrentTermsVersion": "trial-v1",
    "DefaultOrganizationName": "Nexus Organization",
    "DefaultOrganizationSlug": "default",
    "DailyNewDmLimitForUnverified": 5,
    "CaptchaEnabled": false,
    "RegisterRateLimitPerMinutePerIp": 10,
    "LoginRateLimitPerMinutePerIp": 20,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "ResetLinkExpiryMinutes": 30
  },
  "AllowedHosts": "*"
}
