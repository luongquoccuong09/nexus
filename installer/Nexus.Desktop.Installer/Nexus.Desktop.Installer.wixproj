<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <ProductVersion Condition="'$(ProductVersion)' == ''">0.2.0</ProductVersion>
    <PayloadRoot Condition="'$(PayloadRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\work\installer\payload</PayloadRoot>
    <OutputName>ProjectNexus-$(ProductVersion)-x64</OutputName>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductCode=$(ProductCode)</DefineConstants>
    <SuppressIces>ICE61;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
    <BindPath Include="$(PayloadRoot)" BindName="Payload" />
  </ItemGroup>

  <Target Name="ValidateInstallerInputs" BeforeTargets="Build">
    <Error Condition="'$(ProductCode)' == ''" Text="ProductCode is required. Build through scripts\build\Build-DesktopInstaller.ps1 for deterministic product identity." />
    <Error Condition="!Exists('$(PayloadRoot)\ProjectNexus.exe')" Text="Desktop payload is missing: $(PayloadRoot)\ProjectNexus.exe" />
  </Target>
</Project>
